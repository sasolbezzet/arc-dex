# Browser-exposed configuration only. Every VITE_* value is public after build.
VITE_API_BASE_URL=https://43.134.14.43.nip.io
VITE_BASE_PATH=/arc-dex/
VITE_ARCOX_ROUTER_FEE_BPS=30

# SIWE (EIP-4361) auth mode. Keep false until the backend /api/auth/session
# endpoint is migrated to verify SIWE messages. Set to true once the backend
# supports SIWE to enable the standard MetaMask/Blockaid-friendly sign-in flow.
VITE_SIWE_ENABLED=false

# Optional: override the domain bound in the SIWE message. Useful for preview
# deployments or local dev where the backend expects a specific domain.
# VITE_SIWE_DOMAIN=arcoxdex.vercel.app

# Never put API keys, provider keys, delegate keys, or wallet private keys here.
